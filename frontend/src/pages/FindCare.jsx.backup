    ],
  },
  {
    id: 'vadodara-5',
    type: 'Clinic',
    name: 'Dr. Reshmi Banerjee Clinic',
    specialty: 'Women’s Health, Maternity & Gynae',
    address: 'GF 1,2 & FF 1,2,3, Syamal Sapphire, Gotri-Vasna Link Road, near Nilamber Circle, Vadodara, Gujarat',
    phone: '+91 265 289 4444',
    latitude: 22.3235,

# Hosted Supabase project. Keep the service-role key on the backend only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional integrations; omit to disable them.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# MongoDB/JWT authentication. Keep both values in backend/.env only.
MONGODB_URI=
MONGODB_DATABASE=femcare
JWT_SECRET=
JWT_SESSION_HOURS=24
COOKIE_SECURE=false

# Local/college-demo payments. Demo transactions are not real Razorpay charges.
PAYMENT_MODE=demo

# Configure only when a Razorpay test-mode integration is implemented.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_MONTHLY_PLAN_ID=
# RAZORPAY_ANNUAL_PLAN_ID=
